# Copy to .env and adjust if needed:  cp .env.example .env

# Host port for the LXR web UI  ->  http://localhost:<port>/lxr/source
LXR_WEB_PORT=8080

# Folder containing the code to browse (becomes LXR version "v1").
# Mounted read-only into the container at /src/v1.
LXR_SOURCE_DIR=./src

# Where `make export` writes the static HTML copy.
LXR_EXPORT_DIR=./out

# Set to 1 to force a full re-index on the next `make up`.
LXR_REINDEX=0
